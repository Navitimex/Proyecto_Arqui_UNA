# Plantilla de variables de entorno. Copiar a .env.local (ignorado por git) y completar.
# En Vercel: Project Settings → Environment Variables.

# URL pública donde se despliega el sitio (canonical y Open Graph)
NEXT_PUBLIC_SITE_URL=https://arqui-una.vercel.app

# ID del proyecto en Microsoft Clarity (Settings → Overview)
NEXT_PUBLIC_CLARITY_PROJECT_ID=
