# Plantilla de variables de entorno. Copiar a .env.local (ignorado por git) y completar.
# En Vercel: Project Settings → Environment Variables.

# URL pública donde se despliega el sitio (canonical y Open Graph)
NEXT_PUBLIC_SITE_URL=https://arqui-una.vercel.app

# ID del proyecto en Microsoft Clarity (Settings → Overview)
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Azure AI Search (motor de búsqueda). Ver docs/BUSCADOR_AZURE.md.
# Si se dejan vacías, el sitio usa el buscador local de respaldo.
# URL del servicio, p. ej. https://nombre-del-servicio.search.windows.net
AZURE_SEARCH_ENDPOINT=
# Nombre del índice (por defecto una-contenido)
AZURE_SEARCH_INDEX=una-contenido
# Query key (solo lectura). Esta sí va en Vercel.
AZURE_SEARCH_QUERY_KEY=
# Admin key: SOLO en .env.local para correr `npm run search:index`. Nunca en Vercel ni en git.
AZURE_SEARCH_ADMIN_KEY=
